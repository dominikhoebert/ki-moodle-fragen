{
    "inputs": [
        {
            "type": "promptString",
            "id": "db_path",
            "description": "SQLite Database Path",
            "default": "${workspaceFolder}/db.sqlite"
        }
    ],
    "servers": {
        "sqlite": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "${input:db_path}"
            ]
        },
        "sqlite_bikestore": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "${workspaceFolder}/databases/BikeStore.db"
            ]
        },
